<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!--
    UpgradeCode must never change: it is how Windows finds older Mapee installs to replace.
    It matches the old Mapee.Gui.Setup.vdproj. Scope is per-user to match that installer too
    (see the RequireElevation target in Mapee.Installer.wixproj).
  -->
  <Package Name="Mapee"
           Manufacturer="GoldenTadpole"
           Version="$(var.ProductVersion)"
           UpgradeCode="D4CEFD60-94DE-4F23-A30C-BCFD6BDB264A"
           Scope="perUser"
           Language="1033">

    <SummaryInformation Description="Mapee $(var.ProductVersion) installer" />

    <!--
      AllowSameVersionUpgrades: installing a rebuilt release over an install of the same version
      (e.g. a re-released 1.4.0) replaces it. Without it, Windows would install the two side by side.
    -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <!--
      Mapee 1.0.0 and 1.1.0-1.2.0 were built with other UpgradeCodes, so 1.3.0 didn't replace
      them: users who updated from them still have an old "Mapee" entry in Apps, and its files
      share this install folder. Remove those installs as part of the upgrade too. They were
      per-user like this package, so Windows Installer can find them.
    -->
    <Upgrade Id="D8483D2E-296C-4A44-B875-8D364BF6D023">
      <UpgradeVersion Property="LEGACYMAPEE100FOUND" Minimum="0.0.0" IncludeMinimum="yes" />
    </Upgrade>
    <Upgrade Id="9C606522-1E64-4DD4-A88F-FD5848038034">
      <UpgradeVersion Property="LEGACYMAPEE110FOUND" Minimum="0.0.0" IncludeMinimum="yes" />
    </Upgrade>

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="Mapee.ico" SourceFile="$(var.RepoRoot)\Icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="Mapee.ico" />
    <Property Id="ARPCOMMENTS" Value="A fast and easy to use Minecraft mapper" />
    <Property Id="ARPCONTACT" Value="GoldenTadpole" />
    <Property Id="ARPURLINFOABOUT" Value="https://mapee.net" />

    <!-- Reuse the folder chosen on a previous install (written by InstallFolderMemory). -->
    <Property Id="INSTALLFOLDER" Secure="yes">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKCU" Key="Software\GoldenTadpole\Mapee" Name="InstallFolder" Type="raw" />
    </Property>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="ManufacturerFolder" Name="GoldenTadpole">
        <Directory Id="INSTALLFOLDER" Name="Mapee" />
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="Mapee">
      <!-- Everything dotnet publish produced, including Resources\**. New files are picked up automatically. -->
      <Files Directory="INSTALLFOLDER" Include="$(var.AppPublishDir)\**" />

      <Component Directory="INSTALLFOLDER">
        <File Source="$(var.RepoRoot)\Icon.ico" />
      </Component>

      <Component Id="InstallFolderMemory" Directory="INSTALLFOLDER">
        <RegistryValue Root="HKCU" Key="Software\GoldenTadpole\Mapee" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
      </Component>

      <Component Id="DesktopShortcut" Directory="DesktopFolder">
        <Shortcut Id="DesktopShortcut" Name="Mapee" Target="[INSTALLFOLDER]Mapee.exe" WorkingDirectory="INSTALLFOLDER" Icon="Mapee.ico" />
        <RegistryValue Root="HKCU" Key="Software\GoldenTadpole\Mapee" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder">
        <Shortcut Id="StartMenuShortcut" Name="Mapee" Target="[INSTALLFOLDER]Mapee.exe" WorkingDirectory="INSTALLFOLDER" Icon="Mapee.ico" />
        <RegistryValue Root="HKCU" Key="Software\GoldenTadpole\Mapee" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Feature>

    <!--
      "Launch Mapee" on the last page, ticked by default. AutoUpdater closes Mapee to run this installer
      and doesn't start it again, so without this an update leaves the user with no Mapee open.
      It runs from the installer's UI process, as the user who started the installer.
    -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Mapee" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction Id="LaunchMapee" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" />

    <!-- Welcome -> choose folder -> install, like the old installer (no license page). -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <!-- Not after an uninstall or repair (the product is already installed then). -->
      <Publish Dialog="ExitDialog" Control="Finish" Property="WixShellExecTarget" Value="[INSTALLFOLDER]Mapee.exe" Order="1"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchMapee" Order="2"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
  </Package>
</Wix>
