<Window x:Class="Mapper.Gui.DataUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mapee"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FF232323"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <StackPanel Margin="20,18,20,18">
        <TextBlock Text="Updating block and biome data…" Foreground="#FFD8D8D8" FontSize="14" />
        <ProgressBar x:Name="DownloadProgress"
                     Height="8"
                     Margin="0,14,0,0"
                     Minimum="0"
                     Maximum="1"
                     Background="#FF191919"
                     Foreground="#FF6FA94A"
                     BorderThickness="0" />
        <DockPanel Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="DetailText" Foreground="#FFA5A5A5" FontSize="12" VerticalAlignment="Center" />
            <Button x:Name="SkipButton"
                    DockPanel.Dock="Right"
                    Content="Skip"
                    Padding="14,3"
                    Click="SkipButton_Click" />
        </DockPanel>
    </StackPanel>
</Window>
