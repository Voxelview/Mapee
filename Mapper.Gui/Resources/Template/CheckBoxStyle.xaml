<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Implicit, like TextBoxStyle, and merged one window at a time. Application.Resources is
         empty in this app - every window builds its own resource scope - so an implicit style
         here reaches exactly the windows that ask for it and nothing else.

         Stock WPF draws its own light-theme glyph, which is why the checkboxes were the only
         light thing on any dark panel in the app. -->
    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="#FFEEEEEE"/>
        <Setter Property="Background" Value="#FF0F1012"/>
        <Setter Property="BorderBrush" Value="#FF6B7280"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12"/>
        <!-- Top, not Center. The box has to sit against the first line when the content is two
             lines; on a single line a 14 box top-aligned in a 16 line box is centred anyway. -->
        <Setter Property="VerticalContentAlignment" Value="Top"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <!-- Transparent rather than unset: the gap between box and label has to be
                         part of the hit area, or only the 14px square toggles. -->
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Box" Grid.Column="0" Width="14" Height="14" Margin="0, 1, 0, 0"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <!-- Drawn at the box's own scale with no Stretch. Path.Stretch rescales
                                 the stroke along with the geometry, and a 1.6 stroke that lands on
                                 1.7 goes soft at every scaling factor that is not 100 percent. -->
                            <Path x:Name="Tick" Visibility="Collapsed" Width="12" Height="12"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="#FF0F1012" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M 2.5,6.4 L 4.9,8.8 L 9.5,3.4"/>
                        </Border>

                        <ContentPresenter Grid.Column="1" Margin="8, 0, 0, 0"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="#FF9AA5BC"/>
                        </Trigger>
                        <!-- After the hover trigger on purpose: both conditions hold when you
                             hover a ticked box, and the later setter is the one that survives.
                             The two tones are the accent's selected pair - ToolButtonHook's
                             TurnedOn DefaultBorder and MouseOverBorder - so a ticked box agrees
                             with a lit rail tool and with the style picker's ring. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="#FFE2DA00"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="#FFE2DA00"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="Background" Value="#FFF2EA00"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="#FFF2EA00"/>
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="#FFEEEEEE"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
