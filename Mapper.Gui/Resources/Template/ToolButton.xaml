<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="ToolButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <!-- The thickness is always 1 and the brush goes transparent at rest, so a
                         button never changes size as it gains or loses its outline. -->
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- These drive the buttons nothing else owns - zoom, position, the dimension button.
             The rail's tools set their own brushes from ToolButtonHook, and a local value beats
             a style trigger, so those are unaffected by what is set here. The four below are
             copies of that hook's TurnedOff hover and press pairs, so the two paths agree; they
             have to be updated alongside it, which is exactly what was missed when the accent
             went from green to yellow and left these buttons hovering green on their own. -->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FF4B4800"/>
                <Setter Property="BorderBrush" Value="#FFA7A100"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#FF6A6600"/>
                <Setter Property="BorderBrush" Value="#FFD0C900"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>