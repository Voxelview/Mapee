<UserControl x:Class="Mapper.Gui.PositionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Mapper.Gui"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             Background="Transparent"
             Width="Auto" Height="33">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Template/ToolButton.xaml"/>
                <ResourceDictionary Source="/Resources/Template/StatusColors.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Button x:Name="PositionButton" Height="22" VerticalAlignment="Center" Cursor="Hand"
            Style="{StaticResource ToolButton}" ToolTip="Go to position in world"
            Click="PositionButton_Click">
        <StackPanel Orientation="Horizontal" Margin="6, 0, 6, 0">
            <Image x:Name="PositionIcon" Stretch="Uniform" VerticalAlignment="Center" Margin="0, 0, 6, 0"/>

            <!-- Fixed width: the coordinate is as wide as the world is far from origin, and a
                 label that grows as you pan would shove the zoom slider around with it. -->
            <TextBlock x:Name="PositionLabel" Text="0; 0" Width="96" FontSize="11"
                       Foreground="#FFFFFFFF" VerticalAlignment="Center"
                       TextAlignment="Left" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </Button>
</UserControl>
