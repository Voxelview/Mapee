<UserControl x:Class="Mapper.Gui.StylebarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Mapper.Gui"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             Width="Auto" Height="Auto">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Template/ToolTip.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- The whole set used to sit open down the left edge, which is the space the rail now
             takes. Collapsed to a chip that names the style you are in and opens the rest. -->
        <Border x:Name="ChipBorder" BorderBrush="#FF303337" BorderThickness="1" Background="#FF0F1012" Height="27">
            <Border.Effect>
                <DropShadowEffect Direction="-75" ShadowDepth="2" Opacity="5" BlurRadius="6" Color="Black"/>
            </Border.Effect>

            <Button x:Name="ChipButton" Cursor="Hand" ToolTip="Change render style" Click="ChipButton_Click">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF313438"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF42454B"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>

                <StackPanel Orientation="Horizontal" Margin="4, 0, 8, 0">
                    <Image x:Name="ChipIcon" Width="19" Height="19" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Fill"/>
                    <TextBlock x:Name="ChipLabel" Text="Style" FontSize="11.5" Foreground="#FFDDDDDD"
                               VerticalAlignment="Center" Margin="7, 0, 0, 0"/>
                </StackPanel>
            </Button>
        </Border>

        <!-- Above the chip: the chip sits on the bottom edge of the map, so there is nothing
             below it to open into. -->
        <Popup x:Name="StylePopup" PlacementTarget="{Binding ElementName=ChipBorder}"
               Placement="Top" VerticalOffset="-2" StaysOpen="False" AllowsTransparency="True">
            <Border Background="#FF0F1012" BorderBrush="#FF303337" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Direction="-75" ShadowDepth="2" Opacity="5" BlurRadius="6" Color="Black"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border BorderBrush="#FF303337" BorderThickness="0, 0, 0, 1" Grid.Row="0" Height="25">
                        <StackPanel Background="#FF1D1F21">
                            <Label Content="Styles" FontSize="14" Padding="0" Margin="0, 2, 0, 0"
                                   HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="#FFEEEEEE"/>
                        </StackPanel>
                    </Border>

                    <Grid x:Name="StyleGrid" Grid.Row="1" Margin="6" />
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
