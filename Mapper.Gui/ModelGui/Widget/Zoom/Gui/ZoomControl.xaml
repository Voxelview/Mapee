<UserControl x:Class="Mapper.Gui.ZoomControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Mapper.Gui"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             Background="Transparent"
             Width="Auto" Height="33">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Template/ToolButton.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- The track halves. They exist to be clicked - a bare Track leaves the rail
                 inert - so they must stay hit-testable, which means Transparent and not null. -->
            <Style x:Key="ZoomSliderRepeatButton" TargetType="{x:Type RepeatButton}">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                            <Border Background="Transparent"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ZoomSliderThumb" TargetType="{x:Type Thumb}">
                <Setter Property="Width" Value="11"/>
                <Setter Property="Height" Value="11"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <Ellipse x:Name="Knob" Fill="#FFE0E0E0" Stroke="#FF0F1012" StrokeThickness="1"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Knob" Property="Fill" Value="#FFFFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="Knob" Property="Fill" Value="#FFFFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ZoomSlider" TargetType="{x:Type Slider}">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Slider}">
                            <!-- Transparent, not null: this fills the control's height so a
                                 press anywhere on it is the slider's and never reaches the
                                 frame's drag handler underneath. -->
                            <Grid Background="Transparent">
                                <!-- One pixel, and centred in a control whose height matches the
                                     caption buttons', so the track lands on the same line the
                                     minimize glyph draws a few controls to its right. -->
                                <Border Height="1" VerticalAlignment="Center" Background="#FF484C52"/>

                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource ZoomSliderRepeatButton}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource ZoomSliderRepeatButton}"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ZoomSliderThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Drawn rather than typed. As text these were a glyph in a line box, and a line box
             centres on its own metrics - ascender and descender included - not on its ink, so
             the bar sat off the track by a pixel or two and no nudge fixed it at every size.
             A rectangle centres on the thing you can actually see. -->
        <Button x:Name="DecreaseZoomButton" Grid.Column="0" Width="22" Height="22" VerticalAlignment="Center"
                Style="{StaticResource ToolButton}" ToolTip="Zoom out" Click="DecreaseZoomButton_Click">
            <Rectangle Width="9" Height="1" Fill="#FFE0E0E0"/>
        </Button>

        <!-- Bounds and snapping come from the widget at construction: the map zooms in whole
             levels, so every position on this track is a level the map can actually be at. -->
        <Slider x:Name="ZoomSlider" Grid.Column="1" Width="104" Height="33" VerticalAlignment="Center"
                Style="{StaticResource ZoomSlider}"
                IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="1"
                ToolTip="Zoom level" ValueChanged="ZoomSlider_ValueChanged"/>

        <Button x:Name="IncreaseZoomButton" Grid.Column="2" Width="22" Height="22" VerticalAlignment="Center"
                Style="{StaticResource ToolButton}" ToolTip="Zoom in" Click="IncreaseZoomButton_Click">
            <Grid Width="9" Height="9">
                <Rectangle Width="9" Height="1" VerticalAlignment="Center" Fill="#FFE0E0E0"/>
                <Rectangle Width="1" Height="9" HorizontalAlignment="Center" Fill="#FFE0E0E0"/>
            </Grid>
        </Button>

        <Label x:Name="ZoomPercentageLabel" Grid.Column="3" Content="100%" Foreground="#FFE0E0E0" FontSize="11"
               Width="42" Padding="0" HorizontalContentAlignment="Right" VerticalAlignment="Center" Margin="4, 0, 0, 0"/>
    </Grid>
</UserControl>
