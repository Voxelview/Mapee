<UserControl x:Class="Mapper.Gui.VerticalScrollbarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Mapper.Gui"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             Background="Transparent"
             Width="10" Height="Auto" Loaded="Scrollbar_Loaded">

    <!-- Bottom inset clears the horizontal bar so the two do not cross at the corner. The bar
         itself sits flush against the window's right edge, and wins that edge from WindowChrome's
         resize border by declaring itself hit-testable in the chrome. -->
    <local:MapScrollbar x:Name="ScrollbarControl" Orientation="Vertical" Margin="0, 0, 0, 16"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        ThumbBrush="#FF262B31" ThumbHoverBrush="#FF343B43" ThumbDragBrush="#FF444D58"
                        ThumbBorderBrush="#FF6B7480" ThumbBorderHoverBrush="#FF8A94A1" ThumbBorderDragBrush="#FFA6B0BD"
                        ValueChanged="Scrollbar_ValueChanged" />
</UserControl>
