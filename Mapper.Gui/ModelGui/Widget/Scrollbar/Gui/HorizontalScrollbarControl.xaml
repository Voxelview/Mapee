<UserControl x:Class="Mapper.Gui.HorizontalScrollbarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Mapper.Gui"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             Background="Transparent"
             Width="Auto" Height="10" Loaded="Scrollbar_Loaded">

    <!-- Right inset clears the vertical bar so the two do not cross at the corner. -->
    <!-- No chrome claim: the footer sits between this bar and the window's bottom edge, so it
         never overlaps a resize border, and it keeps click-to-page on its track. -->
    <local:MapScrollbar x:Name="ScrollbarControl" Orientation="Horizontal" Margin="0, 0, 16, 0"
                        ThumbBrush="#FF262B31" ThumbHoverBrush="#FF343B43" ThumbDragBrush="#FF444D58"
                        ThumbBorderBrush="#FF6B7480" ThumbBorderHoverBrush="#FF8A94A1" ThumbBorderDragBrush="#FFA6B0BD"
                        ValueChanged="Scrollbar_ValueChanged" />
</UserControl>
