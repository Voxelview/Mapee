<UserControl x:Class="Mapper.Gui.AtlasControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Mapper.Gui"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             Visibility="Collapsed"
             IsVisibleChanged="UserControl_IsVisibleChanged">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Template/StatusColors.xaml"/>
                <ResourceDictionary Source="/Resources/Template/TextBoxStyle.xaml"/>
                <ResourceDictionary Source="/Resources/Template/ScrollBarStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- TextBlocks rather than RadioButtons: three words in a hairline box, and the click
                 is already being routed centrally by Tag. -->
            <Style x:Key="SortOption" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Padding" Value="9, 3, 9, 4"/>
                <Setter Property="Foreground" Value="#FFA9AFB6"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FF25282B"/>
                        <Setter Property="Foreground" Value="#FFEEEEEE"/>
                    </Trigger>
                    <!-- Set from code, and after the hover trigger so it wins on a hovered
                         selection. -->
                    <DataTrigger Binding="{Binding Path=(local:AtlasControl.IsSelectedSort), RelativeSource={RelativeSource Self}}" Value="True">
                        <Setter Property="Background" Value="#FF2F2E1C"/>
                        <Setter Property="Foreground" Value="#FFE2DA00"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- The scrim MUST carry a real brush and never a null one. That is what makes it
         hit-testable, and hit-testing is the only thing standing between this control and a
         panning map: ScaleBehaviour.MouseDown bails on !GraphicsCanvas.IsMouseOver, and because
         the Atlas is a SIBLING of the canvas rather than a child, a hit that lands here takes
         IsMouseOver off the canvas. MouseHook.MouseDown is a global hook, so that guard is the
         whole defence. Assigned in code-behind - it has two strengths. -->
    <Border x:Name="Scrim" Background="#E0090A0B" SizeChanged="Scrim_SizeChanged">
        <!-- Width is assigned in code, to a whole number of plate columns. Left to size itself
             around its content the whole panel - header included - narrowed and re-centred every
             time a search matched fewer worlds, and the close button drifted with it. Snapping to
             columns makes the width a function of the window alone, so filtering moves nothing and
             the header's right edge lands on the last column's. -->
        <!-- The top margin is the odd one out: it is not symmetry with the bottom but breathing
             room under the title bar, which sits directly above this and would otherwise have the
             header crowded against it. -->
        <Grid x:Name="ContentHost" HorizontalAlignment="Center" Margin="18, 40, 18, 14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 7 to the left lines the title up with the first plate's border, and the right
                 margin is set in code: it has to clear the scroll bar so the close button sits over
                 the last plate rather than past it. -->
            <Grid x:Name="HeaderRow" Grid.Row="0" Margin="7, 0, 7, 12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Worlds" FontSize="17" FontWeight="Bold"
                           VerticalAlignment="Center" Foreground="#FFEEEEEE"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="11, 2, 10, 0"
                            VerticalAlignment="Center">
                    <!-- Fixed, because the text swings between "5 worlds" and "3 of 5" as you
                         type and on auto width every keystroke shunted the sort buttons sideways.
                         Same reasoning as the status bar's fixed value widths. -->
                    <TextBlock x:Name="CountLabel" FontSize="11.5" Width="78" Margin="0, 0, 8, 0"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Foreground="{DynamicResource LabelColor}"/>

                    <TextBlock Text="SORT" FontSize="9" FontWeight="SemiBold" Margin="0, 1, 7, 0"
                               VerticalAlignment="Center" Foreground="{DynamicResource LabelColor}"/>

                    <!-- Recent is folder write time until a world's level.dat has been read, then
                         its LastPlayed - see AtlasControl.CompareRecent. -->
                    <Border BorderBrush="#FF3A3E43" BorderThickness="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SortRecent" Tag="recent" Text="Recent" Style="{StaticResource SortOption}" MouseLeftButtonDown="Sort_MouseLeftButtonDown"/>
                            <Border Width="1" Background="#FF3A3E43"/>
                            <TextBlock x:Name="SortName" Tag="name" Text="Name" Style="{StaticResource SortOption}" MouseLeftButtonDown="Sort_MouseLeftButtonDown"/>
                            <Border Width="1" Background="#FF3A3E43"/>
                            <TextBlock x:Name="SortVersion" Tag="version" Text="Version" Style="{StaticResource SortOption}" MouseLeftButtonDown="Sort_MouseLeftButtonDown"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="DIMENSION" FontSize="9" FontWeight="SemiBold" Margin="14, 1, 7, 0"
                               VerticalAlignment="Center" Foreground="{DynamicResource LabelColor}"/>

                    <!-- Picking one here does two things: it redraws every plate from the scan that
                         already read all three, and it decides which dimension opening a world
                         drops you into. -->
                    <Border BorderBrush="#FF3A3E43" BorderThickness="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="DimensionOverworld" Tag="overworld" Text="Overworld" Style="{StaticResource SortOption}" MouseLeftButtonDown="Dimension_MouseLeftButtonDown"/>
                            <Border Width="1" Background="#FF3A3E43"/>
                            <TextBlock x:Name="DimensionNether" Tag="nether" Text="Nether" Style="{StaticResource SortOption}" MouseLeftButtonDown="Dimension_MouseLeftButtonDown"/>
                            <Border Width="1" Background="#FF3A3E43"/>
                            <TextBlock x:Name="DimensionEnd" Tag="end" Text="The End" Style="{StaticResource SortOption}" MouseLeftButtonDown="Dimension_MouseLeftButtonDown"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Built rather than styled: a TextBox has no placeholder, and the app's implicit
                     TextBoxStyle draws the field's border from inside its own template. So the
                     frame is this Border, and the TextBox inside it is stripped back to a caret -
                     BorderThickness 0 makes the template's border draw nothing whatever its
                     triggers set the brush to. -->
                <Border x:Name="SearchFrame" Grid.Column="2" Width="212" Height="26"
                        Background="#FF0F1012" BorderBrush="#FF383B3F" BorderThickness="1"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0" Width="12" Height="12" Margin="8, 0, 0, 0"
                              VerticalAlignment="Center" Stretch="Uniform"
                              Stroke="#FF8A9099" StrokeThickness="1.6"
                              Data="M 6,1.6 A 4.4,4.4 0 1 1 5.99,1.6 Z M 9.4,9.4 L 12.8,12.8"/>

                        <!-- Behind the box, not inside it: a TextBox cannot hold a watermark, and
                             hit-testing is off so a click still lands on the field under it. -->
                        <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="Search worlds"
                                   FontSize="12.5" Margin="7, 0, 7, 0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" Foreground="#FF5F656C"/>

                        <TextBox x:Name="SearchBox" Grid.Column="1" FontSize="12.5"
                                 Background="Transparent" BorderThickness="0" Padding="7, 2, 7, 0"
                                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                                 TextChanged="SearchBox_TextChanged"/>
                    </Grid>

                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#FF50545A"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="#FFE2DA00"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!-- Bordered labels rather than Buttons, so these read as the same kind of control
                     as the sort options beside them - one hairline box each, and the same hover.
                     They share SortOption outright; its selected trigger reads an attached
                     property that stays false here, so it simply never fires. -->
                <Border Grid.Column="3" BorderBrush="#FF3A3E43" BorderThickness="1"
                        Margin="10, 0, 0, 0" VerticalAlignment="Center">
                    <TextBlock Text="Browse…" Style="{StaticResource SortOption}"
                               MouseLeftButtonDown="Browse_Click"
                               ToolTip="Open a world from anywhere on disk."/>
                </Border>

                <Border Grid.Column="4" BorderBrush="#FF3A3E43" BorderThickness="1"
                        Margin="6, 0, 0, 0" VerticalAlignment="Center">
                    <TextBlock Text="✕" Style="{StaticResource SortOption}"
                               MouseLeftButtonDown="Close_Click" ToolTip="Close (Esc)"/>
                </Border>
            </Grid>

            <!-- HorizontalScrollBarVisibility must stay Disabled. On anything else the ScrollViewer
                 measures the WrapPanel at infinite width and it never wraps - every plate ends up
                 in one row. -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="0, 0, 4, 0">
                <!-- Transparent, not unset, on both: the gaps between plates and the empty space
                     under the last row have to be hit-testable or a click there reaches nothing
                     and the panel refuses to close. -->
                <Grid Background="Transparent">
                    <WrapPanel x:Name="PlateContainer" Orientation="Horizontal" Background="Transparent"/>

                    <TextBlock x:Name="EmptyLabel" FontSize="13" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="40, 60, 40, 0" LineHeight="22"
                               LineStackingStrategy="BlockLineHeight"
                               Visibility="Collapsed" Foreground="{DynamicResource LabelColor}"/>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
