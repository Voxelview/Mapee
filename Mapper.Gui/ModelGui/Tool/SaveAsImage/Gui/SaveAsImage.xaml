<Window x:Class="Mapper.Gui.SaveAsImageControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Mapper.Gui"
        mc:Ignorable="d"
        BorderBrush="#FF383B3F"
        BorderThickness="1"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        Icon="{DynamicResource ExportAccent}"
        Template="{DynamicResource CustomWindowFrameTemplate}"
        Title="Export as image"
        Width="432" SizeToContent="Height"
        Background="#FF191B1C" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" SizeChanged="Window_SizeChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="0" CaptionHeight="0" UseAeroCaptionButtons="False" ResizeBorderThickness="7"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Template/CustomWindowFrameTemplate.xaml"/>
                <ResourceDictionary Source="/Resources/Icon/ToolButtonIcons.xaml"/>
                <ResourceDictionary Source="/Resources/Template/StatusColors.xaml"/>
                <ResourceDictionary Source="/Resources/Template/CheckBoxStyle.xaml"/>
                <ResourceDictionary Source="/Resources/Template/DialogButton.xaml"/>
                <ResourceDictionary Source="/Resources/Template/ToolTip.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- The universal alpha checker, and deliberately light in a dark dialog. It is the
                 one pattern everyone reads as "no background"; darkening it to suit the panel
                 would put a second dark checker beside the real one and lose the distinction
                 the swatch row exists to draw. Its counterpart, the map's own checker, is built
                 in code-behind from IImageSaver.GetCheckerColors - the pair is per dimension. -->
            <DrawingBrush x:Key="AlphaCheckerBrush" TileMode="Tile"
                          Viewport="0, 0, 16, 16" ViewportUnits="Absolute">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#FFFFFFFF">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0, 0, 16, 16"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#FFC8C8C8">
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <RectangleGeometry Rect="8, 0, 8, 8"/>
                                    <RectangleGeometry Rect="0, 8, 8, 8"/>
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>

            <!-- Radios rather than toggles or bare Borders. The group is what makes the two
                 cards exclusive, keyboard arrows move within it for free, and IsEnabled
                 inherits from the container the code-behind disables while saving. Nothing of
                 the stock bullet chrome survives - it lived in the template this replaces. -->
            <Style x:Key="ModeCard" TargetType="{x:Type RadioButton}">
                <Setter Property="Background" Value="#FF202325"/>
                <Setter Property="BorderBrush" Value="#FF34383D"/>
                <Setter Property="BorderThickness" Value="1"/>
                <!-- Stretch on both, or the ContentPresenter shrink-wraps and the blurb never
                     gets a width to wrap against. -->
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Top"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RadioButton}">
                            <Border x:Name="Card" SnapsToDevicePixels="True"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter Margin="11, 9, 11, 11"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="#FF252A2D"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="#FF6B7280"/>
                                </Trigger>
                                <!-- After hover on purpose: both hold when you hover the
                                     selected card, and the later trigger is the one that wins.
                                     #FFE3B200 is "selected" everywhere in this app - see
                                     ToolButtonHook.TurnedOn.DefaultBorder, and the rings the
                                     style and dimension pickers draw with it. The fill is the
                                     panel colour carried a fifth of the way toward the accent;
                                     the rail's own TurnedOn fill is sized for a 30px button and
                                     would be a slab of olive across 195px of card. -->
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="#FF2E2C1E"/>
                                    <Setter TargetName="Card" Property="BorderBrush" Value="#FFE3B200"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsChecked" Value="True"/>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Card" Property="Background" Value="#FF34301B"/>
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SwatchCard" TargetType="{x:Type RadioButton}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="#FFBBBBBB"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RadioButton}">
                            <!-- The ring is always 1px and only its brush changes, so moving the
                                 selection never reflows the row. The 3px padding keeps it off
                                 the art. -->
                            <Border x:Name="Ring" Padding="3" Background="Transparent" SnapsToDevicePixels="True"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <StackPanel>
                                    <!-- The frame is what makes a near-flat checker and a patch
                                         of pure black read as objects rather than as holes in
                                         the panel. -->
                                    <Border x:Name="Frame" Height="34" BorderBrush="#FF34383D" BorderThickness="1">
                                        <Rectangle Fill="{TemplateBinding Background}"
                                                   RenderOptions.EdgeMode="Aliased"/>
                                    </Border>
                                    <TextBlock x:Name="Caption" Text="{TemplateBinding Content}"
                                               Margin="0, 5, 0, 0" FontSize="11"
                                               HorizontalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Ring" Property="BorderBrush" Value="#FF50545A"/>
                                    <Setter TargetName="Caption" Property="Foreground" Value="#FFEEEEEE"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Ring" Property="BorderBrush" Value="#FFE3B200"/>
                                    <Setter TargetName="Caption" Property="Foreground" Value="#FFEEEEEE"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Ring" Property="BorderBrush" Value="#FF9AA5BC"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Every row Auto, no star anywhere. SizeToContent="Height" has no natural height to hand
         a star row, so one would collapse to its minimum and take the layout with it. The gap
         under the footer is this Grid's bottom margin. -->
    <Grid Margin="15, 12, 15, 14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Everything the user can operate lives under here, so a save in flight is one
             IsEnabled assignment. The status line below is outside it: it is an output. -->
        <Grid x:Name="InteractionRoot" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 432 outer, less the template's 1px border a side and this Grid's 15px margin a
                 side, is 400 usable. Less a 10 gutter that is 195 a card - whole, so neither
                 card lands on a half pixel and UseLayoutRounding has nothing to break. -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <RadioButton x:Name="ScreenshotCard" Grid.Column="0" GroupName="ExportMode"
                             Style="{StaticResource ModeCard}" Checked="ScreenshotCard_Checked"
                             ToolTip="Captures the screen as you see it. Some scaling artifacts may be present.">
                    <StackPanel>
                        <TextBlock Text="Screenshot" FontSize="13" FontWeight="Bold" Foreground="#FFEEEEEE"/>
                        <TextBlock x:Name="ScreenshotSizeLabel" FontSize="12" Margin="0, 4, 0, 0"
                                   Foreground="{DynamicResource LabelSizeColor}"/>
                        <!-- Both blurbs are held to two lines at this width. The full sentence
                             is on the ToolTip; run longer here and one card gains a line the
                             other has not got. -->
                        <TextBlock Text="What you see on screen. Slight scaling artifacts."
                                   FontSize="11" TextWrapping="Wrap" LineHeight="15"
                                   LineStackingStrategy="BlockLineHeight"
                                   Margin="0, 7, 0, 0" Foreground="#FF8A9099"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="FullResolutionCard" Grid.Column="2" GroupName="ExportMode"
                             Style="{StaticResource ModeCard}" Checked="FullResolutionCard_Checked"
                             ToolTip="Saves one pixel per block. Gridlines are not drawn and the file can be very large.">
                    <StackPanel>
                        <TextBlock Text="Full resolution" FontSize="13" FontWeight="Bold" Foreground="#FFEEEEEE"/>
                        <TextBlock x:Name="FullResolutionSizeLabel" FontSize="12" Margin="0, 4, 0, 0"
                                   Foreground="{DynamicResource LabelSizeColor}"/>
                        <TextBlock Text="One pixel per block. No gridlines, large files."
                                   FontSize="11" TextWrapping="Wrap" LineHeight="15"
                                   LineStackingStrategy="BlockLineHeight"
                                   Margin="0, 7, 0, 0" Foreground="#FF8A9099"/>
                    </StackPanel>
                </RadioButton>
            </Grid>

            <!-- The point of the redesign. Collapsed, not Hidden: WPF measures a collapsed
                 element as 0x0 and skips its margin with it, so the 16 above this goes too and
                 screenshot mode is left with no dead space at all. -->
            <Grid x:Name="OptionsPanel" Grid.Row="1" Margin="0, 16, 0, 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Padding spelled out rather than left at Label's default 5,5,5,5, which is
                     what makes the same header elsewhere in the app sit loose above its rule. -->
                <Label Grid.Row="0" Content="Area" FontSize="15" FontWeight="Bold"
                       Foreground="#FFEEEEEE" Padding="0, 0, 0, 3" HorizontalAlignment="Left"/>
                <Border Grid.Row="1" BorderBrush="#FF50545A" BorderThickness="0, 1, 0, 0" HorizontalAlignment="Stretch"/>

                <!-- The sub-line sits inside Content, not beside it, so clicking the
                     explanation toggles the option and the indent cannot drift from the box. -->
                <CheckBox x:Name="ClipAreaCheckBox" Grid.Row="2" Margin="0, 9, 0, 0"
                          Checked="ClipAreaCheckBox_Changed" Unchecked="ClipAreaCheckBox_Changed">
                    <StackPanel>
                        <TextBlock Text="Clip to rendered regions" FontSize="12" Foreground="#FFEEEEEE"/>
                        <TextBlock Text="Trims empty space around the map." FontSize="11"
                                   Margin="0, 2, 0, 0" Foreground="#FF8A9099"/>
                    </StackPanel>
                </CheckBox>

                <Label Grid.Row="3" Content="Background" FontSize="15" FontWeight="Bold"
                       Foreground="#FFEEEEEE" Margin="0, 15, 0, 0" Padding="0, 0, 0, 3" HorizontalAlignment="Left"/>
                <Border Grid.Row="4" BorderBrush="#FF50545A" BorderThickness="0, 1, 0, 0" HorizontalAlignment="Stretch"/>

                <!-- 400 usable less two 8 gutters is 384, which is 128 a swatch. -->
                <Grid Grid.Row="5" Margin="0, 10, 0, 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CheckerSwatch's Background is assigned in Window_Loaded from the
                         dimension's own pair. -->
                    <RadioButton x:Name="CheckerSwatch" Grid.Column="0" GroupName="ExportBackground"
                                 Style="{StaticResource SwatchCard}" Content="Checker"
                                 Checked="BackgroundSwatch_Checked"/>
                    <RadioButton x:Name="BlackSwatch" Grid.Column="2" GroupName="ExportBackground"
                                 Style="{StaticResource SwatchCard}" Content="Black"
                                 Background="#FF000000" Checked="BackgroundSwatch_Checked"/>
                    <RadioButton x:Name="TransparentSwatch" Grid.Column="4" GroupName="ExportBackground"
                                 Style="{StaticResource SwatchCard}" Content="Transparent"
                                 Background="{StaticResource AlphaCheckerBrush}" Checked="BackgroundSwatch_Checked"/>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="1" BorderBrush="#FF50545A" BorderThickness="0, 1, 0, 0" Margin="0, 16, 0, 0"/>

        <Grid Grid.Row="2" Margin="0, 12, 0, 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Trims rather than wraps, and stays one line. This label doubles as the saving
                 indicator, and under SizeToContent anything that changed height here would
                 resize the window mid-save. -->
            <TextBlock x:Name="OutputInfoLabel" Grid.Column="0" FontSize="11"
                       VerticalAlignment="Center" Margin="0, 0, 10, 0"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource LabelColor}"/>

            <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Width="86" Height="26"
                    IsCancel="True" Style="{StaticResource DialogButton}" Click="CancelButton_Click"/>
            <Button x:Name="SaveButton" Grid.Column="2" Content="Save as..." Width="104" Height="26"
                    Margin="8, 0, 0, 0" IsDefault="True"
                    Style="{StaticResource DialogPrimaryButton}" Click="SaveButton_Click"/>
        </Grid>

        <!-- A Grid, not a horizontal StackPanel: a StackPanel measures its children at infinite
             width and the wrap would never fire. -->
        <Grid x:Name="WarningRow" Grid.Row="3" Margin="0, 10, 0, 0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Path Grid.Column="0" Width="13" Height="12" Margin="0, 1, 7, 0" Stretch="Uniform"
                  Fill="{DynamicResource LabelSizeColor}"
                  Data="M 8,0 L 16,14 L 0,14 Z M 7,4 L 9,4 L 8.6,9 L 7.4,9 Z M 7,10.4 L 9,10.4 L 9,12.4 L 7,12.4 Z"/>
            <TextBlock x:Name="WarningLabel" Grid.Column="1" FontSize="11" TextWrapping="Wrap"
                       LineHeight="15" LineStackingStrategy="BlockLineHeight"
                       Foreground="{DynamicResource LabelSizeColor}"/>
        </Grid>
    </Grid>
</Window>
